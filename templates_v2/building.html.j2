{% extends "base.html.j2" %}

{% block title %}{{ page_title or ((building.name or "建物詳細") ~ " | tatemono-map") }}{% endblock %}

{% block header_meta %}
  <a class="muted" href="{{ base_path }}/" aria-label="一覧に戻る">← 一覧に戻る</a>
{% endblock %}

{% block extra_head %}
<style>
  .stack { display: grid; gap: 14px; }
  .breadcrumb { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px; font-size: .9rem; color: var(--muted); }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .hero, .map-embed, .info, .line-cta { padding: clamp(16px, 2.5vw, 24px); }
  .hero p { margin: 8px 0 0; color: var(--muted); }
  .facts { margin: 0; display: grid; gap: 10px; }
  .fact { margin: 0; display: grid; grid-template-columns: 128px minmax(0,1fr); border-top: 1px solid var(--border-soft); padding-top: 9px; }
  .fact:first-child { border-top: 0; padding-top: 0; }
  .fact dt { color: var(--muted); }
  .fact dd { margin: 0; font-weight: 600; }
  .line-cta {
    border: 1px solid var(--line-border);
    background: linear-gradient(180deg, var(--line-bg-start) 0%, var(--line-bg-end) 100%);
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .line-cta p { margin: 0; color: var(--line-cta-text); }
  .map-embed-frame {
    width: 100%;
    height: 260px;
    border-radius: 12px;
    overflow: hidden;
  }
  .map-embed-frame iframe { width: 100%; height: 100%; display: block; }
  .related { padding: clamp(16px, 2.5vw, 24px); }
  .related ul { margin: 10px 0 0; padding-left: 18px; display: grid; gap: 4px; }
  @media (min-width: 741px) {
    .map-embed-frame { height: 340px; }
  }
  @media (max-width: 740px) {
    .fact { grid-template-columns: 1fr; gap: 2px; }
    .line-cta .button { max-width: none; width: 100%; }
  }
</style>
{% if breadcrumb_json_ld %}
<script type="application/ld+json">{{ breadcrumb_json_ld | safe }}</script>
{% endif %}
{% endblock %}

{% block content %}
<div class="stack">
  {% if breadcrumb_items %}
  <nav aria-label="パンくず">
    <ol class="breadcrumb">
      {% for crumb in breadcrumb_items %}
      <li>{% if not loop.last %}<a href="{{ crumb.url }}">{{ crumb.name }}</a> ›{% else %}{{ crumb.name }}{% endif %}</li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}
  <section class="hero card" aria-label="建物概要">
    <h1>{{ building.name or "名称未設定" }}</h1>
    <p>{{ building.render_address or "住所情報なし" }}</p>
  </section>

  {% if maps_embed_url %}
  <section class="map-embed card" aria-label="Googleマップ埋め込み">
    <div class="map-embed-frame">
      <iframe
        src="{{ maps_embed_url }}"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
        style="border:0"
      ></iframe>
    </div>
  </section>
  {% endif %}

  {% if building.detail_mode == "sale" %}
  <section class="info card" aria-label="売出し情報">
    <h2>売出し情報</h2>
    <dl class="facts">
      <div class="fact"><dt>販売状況</dt><dd>{{ building.sale_status_label }}</dd></div>
      {% if (building.sale_summary and (building.sale_summary.sale_listing_count or 0) > 0) or (building.sale_listing_count or 0) > 0 %}
      <div class="fact"><dt>価格</dt><dd>{{ building.sale_price_label or "販売中" }}</dd></div>
      <div class="fact"><dt>間取り</dt><dd>{{ building.sale_layout_label or "要確認" }}</dd></div>
      <div class="fact"><dt>面積</dt><dd>{{ building.sale_area_label or "要確認" }}</dd></div>
      <div class="fact"><dt>管理費</dt><dd>{% if building.sale_summary and (building.sale_summary.management_fee_yen_min or building.sale_summary.management_fee_yen_max) %}{{ (building.sale_summary.management_fee_yen_min|yen ~ "円/月") if building.sale_summary.management_fee_yen_min == building.sale_summary.management_fee_yen_max else (building.sale_summary.management_fee_yen_min|yen ~ "円/月〜" ~ building.sale_summary.management_fee_yen_max|yen ~ "円/月") }}{% endif %}</dd></div>
      <div class="fact"><dt>修繕積立金</dt><dd>{% if building.sale_summary and (building.sale_summary.repair_fund_yen_min or building.sale_summary.repair_fund_yen_max) %}{{ (building.sale_summary.repair_fund_yen_min|yen ~ "円/月") if building.sale_summary.repair_fund_yen_min == building.sale_summary.repair_fund_yen_max else (building.sale_summary.repair_fund_yen_min|yen ~ "円/月〜" ~ building.sale_summary.repair_fund_yen_max|yen ~ "円/月") }}{% endif %}</dd></div>
      <div class="fact"><dt>所在階</dt><dd>{{ building.sale_summary.floor_summary if building.sale_summary else "" }}</dd></div>
      {% endif %}
    </dl>
  </section>

  <section class="info card" aria-label="建物概要">
    <h2>建物概要</h2>
    <dl class="facts">
      <div class="fact"><dt>築年月</dt><dd>{{ building.built_label or "要確認" }}</dd></div>
      {% if building.building_structure or building.structure %}<div class="fact"><dt>構造</dt><dd>{{ building.building_structure or building.structure }}</dd></div>{% endif %}
      <div class="fact"><dt>階建て</dt><dd>{{ building.sale_summary.floor_count_text if building.sale_summary else "" }}</dd></div>
      <div class="fact"><dt>総戸数</dt><dd>{{ building.sale_summary.total_units if building.sale_summary and building.sale_summary.total_units else "" }}</dd></div>
      <div class="fact"><dt>管理方式</dt><dd>{{ building.sale_summary.management_style if building.sale_summary else "" }}</dd></div>
    </dl>
  </section>
  {% else %}
  <section class="info card" aria-label="募集情報">
    <h2>募集情報</h2>
    <dl class="facts">
      <div class="fact"><dt>空室</dt><dd>{{ building.rental_vacancy_label }}</dd></div>
      {% if (building.vacancy_count or 0) > 0 %}
      {% if building.rental_rent_label %}<div class="fact"><dt>賃料</dt><dd>{{ building.rental_rent_label }}</dd></div>{% endif %}
      {% if building.rental_maint_label %}<div class="fact"><dt>管理費 / 共益費</dt><dd>{{ building.rental_maint_label }}</dd></div>{% endif %}
      {% if building.rental_layout_label %}<div class="fact"><dt>間取り</dt><dd>{{ building.rental_layout_label }}</dd></div>{% endif %}
      {% if building.rental_area_label %}<div class="fact"><dt>面積</dt><dd>{{ building.rental_area_label }}</dd></div>{% endif %}
      {% if building.rental_move_in_label %}<div class="fact"><dt>入居可能日</dt><dd>{{ "即入居あり" if building.rental_move_in_label == "入居" else building.rental_move_in_label }}</dd></div>{% endif %}
      {% else %}
      <div class="fact"><dt>補足</dt><dd>現在、この建物の募集は確認できていません。ご希望に近いお部屋もご案内可能です。</dd></div>
      {% endif %}
      {% if building.built_label %}<div class="fact"><dt>築年月</dt><dd>{{ building.built_label }}</dd></div>{% endif %}
      {% if building.building_structure or building.structure %}<div class="fact"><dt>構造</dt><dd>{{ building.building_structure or building.structure }}</dd></div>{% endif %}
    </dl>
  </section>
  {% endif %}

  <section class="line-cta card" aria-label="LINEで問い合わせる">
    {% if building.detail_mode == "sale" %}
    <h2>お問い合わせ</h2>
    {% if (building.sale_summary and (building.sale_summary.sale_listing_count or 0) > 0) or (building.sale_listing_count or 0) > 0 %}
    <p>この建物の売出し状況にあわせて、購入と売却の相談を受け付けています。</p>
    <a class="button button--line" href="{{ line_cta_url }}" target="_blank" rel="noopener" data-line-universal-url="{{ line_cta_url }}" data-line-deep-link="{{ line_deep_link_url }}" onclick="(function(event){var link=event.currentTarget;var deepLink=link.dataset.lineDeepLink;var fallback=link.dataset.lineUniversalUrl;setTimeout(function(){window.location.href=fallback;},700);window.location.href=deepLink;})(event)">この建物の購入相談をする</a>
    <a class="button" href="{{ line_cta_url }}" target="_blank" rel="noopener">この建物の売却査定をする</a>
    {% else %}
    <p>現在の売出しがない建物でも、売却査定のご相談を受け付けています。</p>
    <a class="button button--line" href="{{ line_cta_url }}" target="_blank" rel="noopener" data-line-universal-url="{{ line_cta_url }}" data-line-deep-link="{{ line_deep_link_url }}" onclick="(function(event){var link=event.currentTarget;var deepLink=link.dataset.lineDeepLink;var fallback=link.dataset.lineUniversalUrl;setTimeout(function(){window.location.href=fallback;},700);window.location.href=deepLink;})(event)">この建物の売却査定をする</a>
    {% endif %}
    {% else %}
    <h2>LINEで空室確認・内見相談</h2>
    <p>最新の空室状況や内見可否を、LINEでまとめて確認できます。</p>
    <a class="button button--line" href="{{ line_cta_url }}" target="_blank" rel="noopener" data-line-universal-url="{{ line_cta_url }}" data-line-deep-link="{{ line_deep_link_url }}" onclick="(function(event){var link=event.currentTarget;var deepLink=link.dataset.lineDeepLink;var fallback=link.dataset.lineUniversalUrl;setTimeout(function(){window.location.href=fallback;},700);window.location.href=deepLink;})(event)">LINEで空室確認・内見相談</a>
    {% endif %}
  </section>

  {% if building.sponsor %}
  <section class="info card" aria-label="このエリアの相談先">
    <h2>このエリアの相談先 <span class="kpi">PR</span></h2>
    <dl class="facts">
      <div class="fact"><dt>会社名</dt><dd>{{ building.sponsor.company_name }}</dd></div>
      <div class="fact"><dt>紹介</dt><dd>{{ building.sponsor.catch_copy }}</dd></div>
      <div class="fact"><dt>対応領域</dt><dd>{{ building.sponsor.coverage_domains }}</dd></div>
      <div class="fact"><dt>対応エリア</dt><dd>{{ building.sponsor.coverage_areas }}</dd></div>
    </dl>
    <a class="button" href="{{ building.sponsor.cta_url }}" target="_blank" rel="noopener">{{ building.sponsor.cta_label }}</a>
  </section>
  {% endif %}

  {% if related_buildings %}
  <section class="related card" aria-label="同じエリアの建物">
    <h2>同じエリアの建物</h2>
    <ul>
      {% for related in related_buildings %}
      <li><a href="{{ base_path }}/b/{{ related.detail_filename }}">{{ related.name or "名称未設定" }}</a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
</div>
{% endblock %}
