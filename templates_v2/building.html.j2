{% extends "base.html.j2" %}

{% block title %}{{ page_title or ((building.name or "建物詳細") ~ " | tatemono-map") }}{% endblock %}

{% block header_meta %}
  <a class="muted" href="{{ base_path }}/" aria-label="一覧に戻る">← 一覧に戻る</a>
{% endblock %}

{% block extra_head %}
<style>
  .stack { display: grid; gap: 14px; }
  .breadcrumb { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px; font-size: .9rem; color: var(--muted); }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .hero, .map-embed, .info, .line-cta { padding: clamp(16px, 2.5vw, 24px); }
  .hero p { margin: 8px 0 0; color: var(--muted); }
  .facts { margin: 0; display: grid; gap: 10px; }
  .fact { margin: 0; display: grid; grid-template-columns: 128px minmax(0,1fr); border-top: 1px solid var(--border-soft); padding-top: 9px; }
  .fact:first-child { border-top: 0; padding-top: 0; }
  .fact dt { color: var(--muted); }
  .fact dd { margin: 0; font-weight: 600; }
  .line-cta {
    border: 1px solid var(--line-border);
    background: linear-gradient(180deg, var(--line-bg-start) 0%, var(--line-bg-end) 100%);
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .line-cta p { margin: 0; color: var(--line-cta-text); }
  .map-embed-frame {
    width: 100%;
    height: 260px;
    border-radius: 12px;
    overflow: hidden;
  }
  .map-embed-frame iframe { width: 100%; height: 100%; display: block; }
  .related { padding: clamp(16px, 2.5vw, 24px); }
  .related ul { margin: 10px 0 0; padding-left: 18px; display: grid; gap: 4px; }
  @media (min-width: 741px) {
    .map-embed-frame { height: 340px; }
  }
  @media (max-width: 740px) {
    .fact { grid-template-columns: 1fr; gap: 2px; }
    .line-cta .button { max-width: none; width: 100%; }
  }
</style>
{% if breadcrumb_json_ld %}
<script type="application/ld+json">{{ breadcrumb_json_ld | safe }}</script>
{% endif %}
{% endblock %}

{% block content %}
<div class="stack">
  {% if breadcrumb_items %}
  <nav aria-label="パンくず">
    <ol class="breadcrumb">
      {% for crumb in breadcrumb_items %}
      <li>{% if not loop.last %}<a href="{{ crumb.url }}">{{ crumb.name }}</a> ›{% else %}{{ crumb.name }}{% endif %}</li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}
  <section class="hero card" aria-label="建物概要">
    <h1>{{ building.name or "名称未設定" }}</h1>
    <p>{{ building.address or "住所情報なし" }}</p>
  </section>

  {% if maps_embed_url %}
  <section class="map-embed card" aria-label="Googleマップ埋め込み">
    <div class="map-embed-frame">
      <iframe
        src="{{ maps_embed_url }}"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
        style="border:0"
      ></iframe>
    </div>
  </section>
  {% endif %}

  <section class="info card" aria-label="詳細情報">
    <h2>募集情報</h2>
    <dl class="facts">
      {% if building.property_kind == "bunjo" %}<div class="fact"><dt>販売情報</dt><dd>{{ building.sale_listing_count if building.sale_listing_count is not none else "—" }}件</dd></div>{% else %}<div class="fact"><dt>空室</dt><dd>{{ building.vacancy_count if building.vacancy_count is not none else "—" }}件</dd></div>{% endif %}
      <div class="fact"><dt>{% if building.property_kind == "bunjo" %}価格レンジ{% else %}家賃{% endif %}</dt><dd>{% if building.property_kind == "bunjo" %}{{ ((building.sale_price_yen_avg / 10000)|int ~ "万円") if building.sale_price_yen_avg is not none else "—" }}{% else %}{{ building.rent_yen_min|yen }}円 〜 {{ building.rent_yen_max|yen }}円{% endif %}</dd></div>
      <div class="fact"><dt>面積</dt><dd>{{ (building.area_sqm_min ~ '㎡') if building.area_sqm_min is not none else '—' }} 〜 {{ (building.area_sqm_max ~ '㎡') if building.area_sqm_max is not none else '—' }}</dd></div>
      <div class="fact"><dt>間取りタイプ</dt><dd>{{ building.layout_types | join(', ') if building.layout_types else '—' }}</dd></div>
      <div class="fact"><dt>入居可能日</dt><dd>{% if building.property_kind == 'bunjo' or (building.vacancy_count or 0) <= 0 %}—{% elif building.building_availability_label == '入居' %}即入居{% elif building.building_availability_label %}{{ building.building_availability_label }}{% else %}{{ building.move_in_dates | join(', ') if building.move_in_dates else '—' }}{% endif %}</dd></div>
      <div class="fact"><dt>築年数</dt><dd>{% if building.building_built_year_month %}{{ building.building_built_year_month }}{% if building.building_built_age_years is not none %} ({{ building.building_built_age_years }}年){% endif %}{% elif building.building_built_age_years is not none %}{{ building.building_built_age_years }}年{% elif building.age_years is not none %}{{ building.age_years }}年{% else %}—{% endif %}</dd></div>
      <div class="fact"><dt>建物構造</dt><dd>{{ building.building_structure or building.structure or '—' }}</dd></div>
    </dl>
  </section>

  <section class="line-cta card" aria-label="LINEで問い合わせる">
    <h2>LINEでスムーズに確認</h2>
    <p>希望条件を送ると、条件に近い募集情報をまとめて確認できます。</p>
    <a
      class="button button--line"
      href="{{ line_cta_url }}"
      target="_blank"
      rel="noopener"
      data-line-universal-url="{{ line_cta_url }}"
      data-line-deep-link="{{ line_deep_link_url }}"
      onclick="(function(event){var link=event.currentTarget;var deepLink=link.dataset.lineDeepLink;var fallback=link.dataset.lineUniversalUrl;setTimeout(function(){window.location.href=fallback;},700);window.location.href=deepLink;})(event)"
    >LINEで条件を送る</a>
  </section>

  {% if related_buildings %}
  <section class="related card" aria-label="同じエリアの建物">
    <h2>同じエリアの建物</h2>
    <ul>
      {% for related in related_buildings %}
      <li><a href="{{ base_path }}/b/{{ related.detail_filename }}">{{ related.name or "名称未設定" }}</a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
</div>
{% endblock %}
