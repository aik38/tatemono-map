USER root
COPY realpro_weekly.py /tmp/realpro-weekly-patch.py
RUN python -c "import pathlib,shutil,hashlib; import tatemono_map.cloud.storage as m; target=pathlib.Path(m.__file__).parent; root=target.parent; before={str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in root.rglob('*.py')}; shutil.copyfile('/tmp/realpro-weekly-patch.py',target/'realpro_weekly.py'); after={str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in root.rglob('*.py')}; assert [p for p in before if before[p]!=after[p]]==[str(target/'realpro_weekly.py')]"
USER collector
ENTRYPOINT ["python"]
CMD ["-m", "tatemono_map.cloud.realpro_weekly"]
