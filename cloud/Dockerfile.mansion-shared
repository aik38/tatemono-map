# Apply only the three shared MR publication/priority compatibility modules.
# Acquisition, PDF parsers, matching and the existing entrypoints are retained.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY fetch_public.py /tmp/shared-cloud/fetch_public.py
COPY building_summaries.py effective_rentals.py /tmp/shared-normalize/
RUN python -c "import pathlib,shutil; import tatemono_map.cloud.storage as c; import tatemono_map.normalize.effective_rentals as n; shutil.copyfile('/tmp/shared-cloud/fetch_public.py',pathlib.Path(c.__file__).parent/'fetch_public.py'); [shutil.copyfile(p,pathlib.Path(n.__file__).parent/p.name) for p in pathlib.Path('/tmp/shared-normalize').glob('*.py')]"
USER collector
